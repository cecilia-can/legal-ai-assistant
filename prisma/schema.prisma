// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String            @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  accounts          Account[]
  sessions          Session[]
  oauthLinkIntents  OAuthLinkIntent[]
  conversations     Conversation[]
  knowledgeBases    KnowledgeBase[]   @relation("KnowledgeBaseOwner")
  uploadedDocuments Document[]        @relation("DocumentUploader")
  embeddingTasks    EmbeddingTask[]   @relation("EmbeddingTaskRequester")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model OAuthLinkIntent {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  userId            String
  email             String
  provider          String
  providerAccountId String
  type              String
  refreshToken      String?   @map("refresh_token") @db.Text
  accessToken       String?   @map("access_token") @db.Text
  expiresAt         Int?      @map("expires_at")
  tokenType         String?   @map("token_type")
  scope             String?
  idToken           String?   @map("id_token") @db.Text
  sessionState      String?   @map("session_state")
  expires           DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expires])
  @@index([expires])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("New Chat")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model KnowledgeBase {
  id        String     @id @default(cuid())
  name      String
  scope     String     @default("user")
  ownerId   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  owner     User?      @relation("KnowledgeBaseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  documents Document[]
  embeddingTasks EmbeddingTask[]

  @@index([ownerId, updatedAt])
  @@index([scope, updatedAt])
}

model Document {
  id                   String          @id @default(cuid())
  knowledgeBaseId      String
  uploadedByUserId     String?
  originalFilename     String
  title                String?
  sourceIdentifier     String
  sourceUri            String?         @db.Text
  sourceType           String
  category             String?
  documentVersion      String?
  contentHash          String
  status               String          @default("pending")
  errorMessage         String?         @db.Text
  parserVersion        String?
  normalizationVersion String?
  normalizedUri        String?         @db.Text
  normalizedContentHash String?
  extractionMethod     String?
  ocrEngine            String?
  ocrVersion           String?
  ocrLanguages         String?
  ocrConfidence        Float?
  publishedAt          DateTime?
  effectiveAt          DateTime?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  knowledgeBase        KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  uploadedBy           User?           @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  chunkSets            DocumentChunkSet[]
  chunks               DocumentChunk[]

  @@unique([knowledgeBaseId, sourceIdentifier, contentHash])
  @@index([knowledgeBaseId, updatedAt])
  @@index([status, updatedAt])
  @@index([category, updatedAt])
}

model DocumentChunkSet {
  id                    String          @id @default(cuid())
  documentId            String
  normalizedContentHash String
  strategyVersion       String
  status                String          @default("pending")
  qualityIssues         Json?
  activatedAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  document              Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks                DocumentChunk[]

  @@unique([documentId, normalizedContentHash, strategyVersion])
  @@index([documentId, status, updatedAt])
}

model DocumentChunk {
  id                   String      @id @default(cuid())
  documentId           String
  chunkSetId           String?
  ordinal              Int
  text                 String      @db.Text
  sectionPath          String?
  locator              Json?
  pageFrom             Int?
  pageTo               Int?
  contentHash          String
  chunkStrategyVersion String
  createdAt            DateTime    @default(now())
  document             Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkSet             DocumentChunkSet? @relation(fields: [chunkSetId], references: [id], onDelete: SetNull)
  embeddings           Embedding[]

  @@unique([chunkSetId, ordinal])
  @@index([documentId, createdAt])
  @@index([chunkSetId, createdAt])
}

model Embedding {
  id          String                 @id @default(cuid())
  chunkId     String
  model       String
  dimensions  Int
  contentHash String
  vector      Unsupported("vector")?
  createdAt   DateTime               @default(now())
  chunk       DocumentChunk          @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([chunkId, model, contentHash])
  @@index([model, dimensions])
}

model EmbeddingTask {
  id                String         @id @default(cuid())
  requestedByUserId String?
  knowledgeBaseId   String?
  documentId        String?
  model             String
  dimensions        Int
  status            String         @default("pending")
  totalChunks       Int            @default(0)
  completedChunks   Int            @default(0)
  failedChunks      Int            @default(0)
  retryCount        Int            @default(0)
  failureDetails    Json?
  errorMessage      String?        @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  requestedBy       User?          @relation("EmbeddingTaskRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  knowledgeBase     KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@index([knowledgeBaseId, createdAt])
  @@index([documentId, createdAt])
}
