# PostgreSQL connection string used by Prisma.
#
# 本地开发（推荐）：先运行 `npm run db:up` 启动 docker-compose.yml 中的
# Postgres + pgvector 容器，再直接使用下面这行默认连接串。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_ai_assistant?schema=public"
#
# 部署 / 云端（如 Neon）：改为对应的托管连接串，并用
# `npx prisma migrate deploy` 应用已有迁移。
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# DeepSeek (OpenAI Compatible API)
# Get your API key from https://platform.deepseek.com/
OPENAI_API_KEY="your_deepseek_api_key"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-chat"

# Chat context window budget (Change 1.7)
# Total model context = input + output. Input budget = CONTEXT - OUTPUT.
CHAT_MAX_CONTEXT_TOKENS="32000"
CHAT_MAX_OUTPUT_TOKENS="4096"

# Structured usage logging (Change 1.7)
# When true, server prints one JSON line per chat request to stdout (console.info).
CHAT_USAGE_LOG="false"

# Auth.js (Change 1.9)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_secret"
AUTH_URL="http://localhost:3000"

# Per-user chat rate limits (Change 1.9)
CHAT_RATE_LIMIT_PER_MINUTE="10"
CHAT_RATE_LIMIT_TOKENS_PER_DAY="50000"
