# PostgreSQL connection string used by Prisma.
#
# 本地开发（推荐）：先运行 `npm run db:up` 启动 docker-compose.yml 中的
# Postgres + pgvector 容器，再直接使用下面这行默认连接串。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_ai_assistant?schema=public"
#
# 部署 / 云端（如 Neon）：改为对应的托管连接串，并用
# `npx prisma migrate deploy` 应用已有迁移。
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# DeepSeek (OpenAI Compatible API)
# Get your API key from https://platform.deepseek.com/
OPENAI_API_KEY="your_deepseek_api_key"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-chat"
