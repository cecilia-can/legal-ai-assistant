# PostgreSQL connection string used by Prisma.
#
# 本地开发（推荐）：先运行 `npm run db:up` 启动 docker-compose.yml 中的
# Postgres + pgvector 容器，再直接使用下面这行默认连接串。
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/legal_ai_assistant?schema=public"
#
# 部署 / 云端（如 Neon）：改为对应的托管连接串，并用
# `npx prisma migrate deploy` 应用已有迁移。
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# DeepSeek (OpenAI Compatible API)
# Get your API key from https://platform.deepseek.com/
OPENAI_API_KEY="your_deepseek_api_key"
OPENAI_BASE_URL="https://api.deepseek.com"
OPENAI_MODEL="deepseek-chat"

# Chat context window budget (Change 1.7)
# Total model context = input + output. Input budget = CONTEXT - OUTPUT.
CHAT_MAX_CONTEXT_TOKENS="32000"
CHAT_MAX_OUTPUT_TOKENS="4096"

# Structured usage logging (Change 1.7)
# When true, server prints one JSON line per chat request to stdout (console.info).
CHAT_USAGE_LOG="false"

# Auth.js (Change 1.9)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_secret"
AUTH_URL="http://localhost:3000"

# OAuth providers (Change 1.9.1, optional)
# GitHub callback: http://localhost:3000/api/auth/callback/github
# Google callback: http://localhost:3000/api/auth/callback/google
# Production callbacks use the same paths under the deployed AUTH_URL.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Per-user chat rate limits (Change 1.9)
CHAT_RATE_LIMIT_PER_MINUTE="10"
CHAT_RATE_LIMIT_TOKENS_PER_DAY="50000"

# Document ingestion (Change 2.2)
# Read-only source directory for local import tasks. Leave empty to allow an explicit --file path.
DOCUMENT_SOURCE_ROOT=""
# Derived OCR PDFs and normalized JSON artifacts are written here.
DOCUMENT_ARTIFACT_ROOT="data/document-artifacts"
# OCRmyPDF/Tesseract executable names or absolute paths.
DOCUMENT_OCR_COMMAND="ocrmypdf"
DOCUMENT_TESSERACT_COMMAND="tesseract"
# LibreOffice headless executable for legacy .doc conversion.
DOCUMENT_OFFICE_COMMAND="soffice"
DOCUMENT_OCR_LANGUAGES="chi_sim+eng"
DOCUMENT_OCR_TIMEOUT_MS="900000"
DOCUMENT_PDF_TEXT_COVERAGE_THRESHOLD="0.05"
